  "narrative": {
    "northStar": "The Marked-Up Catalog",
    "overview": "The app is the fair-day catalog you annotate by hand, not a card-grid directory. A deep Dartmouth-green masthead with index tabs sits over cool newsprint; every club is a dense ruled entry, and the student's choices are pen marks.",
    "keyCharacteristics": ["Green masthead with a folder-tab index", "Ruled entries under a 2px ink rule with circled catalog number", "Bitter slab for names, Archivo for UI, tabular numerals", "Flat; shadows only on overlays", "Light and dark via prefers-color-scheme"],
    "rules": [
      {"name": "The Four Marks Rule", "body": "Pen is the student's action, highlighter is a reason for a match, stamp is a deadline or conflict, green is the system. A color never takes another's job.", "section": "colors"},
      {"name": "The Cool Paper Rule", "body": "The ground is green-tinted newsprint, never cream or warm white.", "section": "colors"},
      {"name": "The Slab Names Rule", "body": "Club names and headings are Bitter; everything operational is Archivo.", "section": "typography"},
      {"name": "The Tabular Rule", "body": "Catalog numbers, counts, hours and costs use tabular numerals.", "section": "typography"},
      {"name": "The Flat Page Rule", "body": "Nothing on the page itself casts a shadow; only the dialog and toast do.", "section": "elevation"}
